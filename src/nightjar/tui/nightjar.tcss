Screen {
    background: #080f0c;
    color: #a7d4b4;
}

#masthead {
    height: 3;
    background: #102019;
    border-bottom: solid #2a563d;
    color: #b8f1c2;
    text-style: bold;
    content-align: left middle;
    padding: 0 1;
}

#workspace {
    height: 1fr;
    min-height: 19;
}

#map_panel {
    width: 1fr;
    min-width: 66;
    border-right: solid #2b4c38;
    padding: 0 1;
}

#telemetry_panel {
    width: 32;
    padding: 0 1;
    background: #0c1812;
    overflow-y: auto;
}

.section_title {
    height: 2;
    color: #89c998;
    text-style: bold;
    padding-top: 1;
}

#map {
    height: 1fr;
    overflow: auto;
    background: #0a1510;
    padding: 1 1;
}

#legend {
    height: 2;
    color: #90b99e;
    padding-top: 1;
}

#agents {
    height: auto;
    padding: 1 0 0 0;
    color: #add7b6;
    overflow: auto;
}

#metrics {
    height: 18;
    padding-top: 1;
    color: #b6d5b2;
}

#bottom_panels {
    height: 11;
    border-top: solid #2b4c38;
}

#events_panel {
    width: 1fr;
    padding: 0 1;
}

#replay_panel {
    width: 37;
    border-left: solid #2b4c38;
    padding: 0 1;
}

#events, #timeline {
    height: 1fr;
    color: #9ec4a6;
    padding-top: 1;
}

#mode_note {
    height: 1;
    background: #102019;
    color: #78a98c;
    padding-left: 1;
}

Footer {
    background: #122719;
    color: #b6e7bd;
}

/* Keep replay controls on screen in compact terminals; desktop sizing is unchanged. */
Screen.compact #masthead {
    height: 2;
}

Screen.compact #workspace {
    min-height: 7;
}

Screen.compact #map_panel {
    min-width: 0;
}

Screen.compact #telemetry_panel {
    overflow-y: auto;
}


#mission_focus {
    height: 2;
    color: #9fcbab;
    background: #102019;
}

#evidence {
    height: auto;
    max-height: 3;
    color: #d6b66c;
}

MissionSummaryScreen {
    align: center middle;
    background: #080f0c 85%;
}

#mission_summary_panel {
    width: 76;
    max-width: 96%;
    height: 23;
    max-height: 96%;
    border: solid #6b916d;
    background: #0c1812;
    padding: 0 1;
}

#summary_title {
    height: 3;
    content-align: left middle;
    color: #e0b45c;
    text-style: bold;
}

#summary_scroll {
    height: 1fr;
}

#summary_body {
    height: auto;
    color: #b6d5b2;
}

#summary_close {
    height: 3;
    width: 100%;
    background: #163420;
    color: #b6e7bd;
    border: solid #31543c;
}

Screen.compact #evidence {
    max-height: 2;
}


/* Two content rows: room/scan legend must not lose a row to padding. */
Screen.gridworld #legend {
    padding-top: 0;
}

/* Preserve map rows and the whole replay status on a 24-row terminal. */
Screen.compact.gridworld #bottom_panels {
    height: 9;
}

Screen.compact.gridworld .section_title {
    height: 1;
    padding-top: 0;
}

Screen.compact.gridworld #map {
    padding: 0 1;
}

Screen.compact.gridworld #events, Screen.compact.gridworld #timeline {
    padding-top: 0;
}
